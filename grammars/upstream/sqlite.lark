PIPE2		: "||"
DIV		: "/"
MOD		: "%"
LT2		: "<<"
GT2		: ">>"
AMP		: "&"
PIPE		: "|"
LT		: "<"
LT_EQ		: "<="
GT		: ">"
GT_EQ		: ">="
EQ		: "=="
NOT_EQ1		: "!="
NOT_EQ2		: "<>"

